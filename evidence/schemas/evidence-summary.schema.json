{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ceos.local/schemas/evidence-summary.schema.json",
  "title": "CEOS Evidence Summary",
  "type": "object",
  "required": [
    "schemaVersion",
    "ceosVersion",
    "mode",
    "verdict",
    "gates"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "CONFIGURATION_ERROR",
        "BLOCKED"
      ]
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "required",
          "risk"
        ],
        "properties": {
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "CONFIGURATION_ERROR",
              "BLOCKED",
              "SKIP"
            ]
          },
          "risk": {
            "enum": [
              "R0",
              "R1",
              "R2",
              "R3"
            ]
          },
          "failureType": {
            "enum": [
              "PRODUCT_FAILURE",
              "TEST_FAILURE",
              "COMMAND_FAILURE",
              "CONFIGURATION_ERROR",
              "INFRA_FAILURE",
              "EXTERNAL_BLOCKER",
              "CAPABILITY_BLOCKER",
              "EVIDENCE_FAILURE",
              "PROVENANCE_FAILURE"
            ]
          },
          "assertionsExecuted": {
            "type": "integer",
            "minimum": 0
          },
          "coverage": {
            "type": "object",
            "properties": {
              "complete": {
                "type": "boolean"
              },
              "checked": {
                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "scope": {
                "type": "string"
              }
            }
          },
          "sourceHead": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{7,64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
